{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Roundtable",
  "version": "0.2.0",
  "identifier": "io.roundtable.desktop",
  "build": {
    "devUrl": "http://127.0.0.1:4173",
    "frontendDist": "../../../ui-prototype/dist"
  },
  "app": {
    "windows": [
      {
        "title": "Roundtable",
        "label": "main",
        "width": 1440,
        "height": 960,
        "minWidth": 1100,
        "minHeight": 700,
        "center": true,
        "transparent": true,
        "windowEffects": { "effects": ["acrylic", "mica"] }
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; connect-src ipc: http://ipc.localhost; script-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico"],
    "windows": {
      "nsis": { "installMode": "currentUser" },
      "webviewInstallMode": { "type": "downloadBootstrapper" }
    }
  }
}
