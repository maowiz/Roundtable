{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "roundtable://papers/improved.v1",
  "title": "Improved answer paper v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "decisions", "answer", "claims", "unresolved"],
  "properties": {
    "schema_version": { "const": "improved.v1" },
    "decisions": {
      "type": "array",
      "maxItems": 400,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["review_alias", "issue_id", "decision", "reason"],
        "properties": {
          "review_alias": { "type": "string", "pattern": "^R-[A-Za-z0-9]{6,12}$" },
          "issue_id": { "type": "string", "pattern": "^I[0-9]{1,3}$" },
          "decision": { "type": "string", "enum": ["accepted", "partly_accepted", "rejected"] },
          "reason": { "type": "string", "minLength": 1, "maxLength": 600 }
        }
      }
    },
    "answer": { "type": "string", "minLength": 1, "maxLength": 20000 },
    "claims": {
      "type": "array",
      "minItems": 1,
      "maxItems": 50,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "text"],
        "properties": {
          "id": { "type": "string", "pattern": "^C[0-9]{1,3}$" },
          "text": { "type": "string", "minLength": 1, "maxLength": 1000 },
          "references": { "type": "array", "maxItems": 20, "items": { "type": "string", "pattern": "^Ref-[0-9]{1,3}$" } }
        }
      }
    },
    "unresolved": { "type": "array", "maxItems": 20, "items": { "type": "string", "minLength": 1, "maxLength": 600 } },
    "self_rating": { "type": ["number", "null"], "minimum": 0, "maximum": 1 }
  }
}
