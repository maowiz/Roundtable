{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "roundtable://papers/answer.v1",
  "title": "Answer paper v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "answer", "assumptions", "claims", "limitations"],
  "properties": {
    "schema_version": { "const": "answer.v1" },
    "answer": { "type": "string", "minLength": 1, "maxLength": 20000 },
    "assumptions": { "type": "array", "maxItems": 20, "items": { "type": "string", "minLength": 1, "maxLength": 500 } },
    "claims": {
      "type": "array",
      "minItems": 1,
      "maxItems": 50,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "text"],
        "properties": {
          "id": { "type": "string", "pattern": "^C[0-9]{1,3}$" },
          "text": { "type": "string", "minLength": 1, "maxLength": 1000 },
          "references": { "type": "array", "maxItems": 20, "items": { "type": "string", "pattern": "^Ref-[0-9]{1,3}$" } }
        }
      }
    },
    "limitations": { "type": "array", "maxItems": 20, "items": { "type": "string", "minLength": 1, "maxLength": 500 } },
    "self_rating": { "type": ["number", "null"], "minimum": 0, "maximum": 1 }
  }
}
