{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "roundtable://papers/final.v1",
  "title": "Final answer paper v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "answer", "key_claims", "unresolved_conflicts", "verification_limitations"],
  "properties": {
    "schema_version": { "const": "final.v1" },
    "answer": { "type": "string", "minLength": 1, "maxLength": 30000 },
    "key_claims": {
      "type": "array",
      "minItems": 1,
      "maxItems": 50,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["text", "support"],
        "properties": {
          "text": { "type": "string", "minLength": 1, "maxLength": 1000 },
          "support": { "type": "string", "enum": ["supported", "unsupported", "unresolved"] },
          "supporting": {
            "type": "array",
            "maxItems": 16,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["candidate_alias"],
              "properties": {
                "candidate_alias": { "type": "string", "pattern": "^C-[A-Za-z0-9]{6,12}$" },
                "claim_id": { "type": ["string", "null"], "pattern": "^C[0-9]{1,3}$" }
              }
            }
          },
          "references": { "type": "array", "maxItems": 20, "items": { "type": "string", "pattern": "^Ref-[0-9]{1,3}$" } }
        }
      }
    },
    "unresolved_conflicts": { "type": "array", "maxItems": 30, "items": { "type": "string", "minLength": 1, "maxLength": 800 } },
    "verification_limitations": { "type": "array", "maxItems": 20, "items": { "type": "string", "minLength": 1, "maxLength": 600 } }
  }
}
