    "title": "Roundtable AI Desktop Architecture",
    "quality_profile": "showcase",
    "views": [
      {
        "id": "ask-path",
        "label": "From question to answer",
        "focus": [
          "user",
          "ui",
          "host",
          "engine",
          "envelope",
          "adapters",
          "openrouter"
        ],
        "note": "The question enters the renderer, the host validates it, the engine builds isolated envelopes and dispatches real requests."
      },
      {
        "id": "isolation",
        "label": "Memory isolation",
        "focus": [
          "engine",
          "envelope",
          "ledger",
          "schemas"
        ],
        "note": "Every call is a fresh request built only from committed ledger rows the stage may see; papers are validated before they are stored."
      },
      {
        "id": "secrets-money",
        "label": "Keys and money",
        "focus": [
          "secrets",
          "credman",
          "budget",
          "prices",
          "ledger"
        ],
        "note": "API keys never leave Credential Manager; every call reserves budget before dispatch and settles after."
      }
    ]
  },
